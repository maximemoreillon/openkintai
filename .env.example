DATABASE_URL=postgresql://user:password@localhost:5432/openkintai
NUXT_SESSION_PASSWORD=changeme-32-character-minimum-secret

NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=
NUXT_OAUTH_OIDC_OPENID_CONFIG=https://your-provider.example.com/.well-known/openid-configuration
# Only needed behind a proxy/tunnel that doesn't set X-Forwarded-Proto
# correctly (e.g. Cloudflare Tunnel) — see README "Reverse proxies / tunnels".
NUXT_OAUTH_OIDC_REDIRECT_URL=
NUXT_MANAGER_GROUP=openkintai-managers
# Optional: lets clients call /api/* with an "x-api-key" header as a
# manager. Leave empty to disable API-key access.
NUXT_API_KEY=
# Optional: restrict clock in/out to these comma-separated IPs/CIDRs (e.g.
# the office's public IP when behind Cloudflare). "self" = this server's own
# public IP, for apps hosted on the office network. Empty = no restriction.
NUXT_CLOCK_ALLOWED_NETWORKS=
# Header carrying the real client IP behind a proxy, e.g. cf-connecting-ip.
# Empty = use the TCP peer address.
NUXT_CLIENT_IP_HEADER=

NUXT_PUBLIC_LOCALE=ja-JP
NUXT_PUBLIC_USER_MANAGEMENT_URL=

TZ=Asia/Tokyo
